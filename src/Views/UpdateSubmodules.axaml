<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SourceGit.Views.UpdateSubmodules"
             x:DataType="vm:UpdateSubmodules">
  <StackPanel Orientation="Vertical" Margin="8,0">
    <StackPanel Orientation="Horizontal">
      <Path Width="16" Height="16"
            Data="{StaticResource Icons.Loading}"/>

      <TextBlock FontSize="18"
                 Margin="8,0,0,0"
                 Classes="bold"
                 Text="{DynamicResource Text.UpdateSubmodules}"/>
    </StackPanel>

    <Grid Margin="0,16,0,0" RowDefinitions="32,Auto,Auto,32,32" ColumnDefinitions="120,*">
      <TextBlock Grid.Row="0" Grid.Column="0"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,0,8,0"
                 Text="{DynamicResource Text.UpdateSubmodules.Target}"/>
      <ComboBox Grid.Row="0" Grid.Column="1"
                Height="28" Padding="8,0"
                VerticalAlignment="Center" HorizontalAlignment="Stretch"
                ItemsSource="{Binding Submodules}"
                SelectedItem="{Binding SelectedSubmodule, Mode=TwoWay}">
        <ComboBox.IsEnabled>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="UpdateAll" Converter="{x:Static BoolConverters.Not}"/>
            <Binding Path="HasPreSelectedSubmodule" Converter="{x:Static BoolConverters.Not}"/>
          </MultiBinding>
        </ComboBox.IsEnabled>

        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="m:Submodule">
            <StackPanel Orientation="Horizontal" Height="20" VerticalAlignment="Center">
              <Path Margin="0,0,8,0" Width="14" Height="14" Fill="{DynamicResource Brush.FG1}" Data="{StaticResource Icons.Submodule}"/>
              <TextBlock Text="{Binding Path, Mode=OneWay}"/>
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <CheckBox Grid.Row="1" Grid.Column="1"
                Height="32"
                Content="{DynamicResource Text.UpdateSubmodules.All}"
                IsChecked="{Binding UpdateAll, Mode=TwoWay}"
                IsVisible="{Binding !HasPreSelectedSubmodule, Mode=OneWay}"/>

      <CheckBox Grid.Row="2" Grid.Column="1"
                Height="32"
                Content="{DynamicResource Text.UpdateSubmodules.Init}"
                IsChecked="{Binding EnableInit, Mode=TwoWay}"
                IsVisible="{Binding IsEnableInitVisible, Mode=OneWay}"
                ToolTip.Tip="--init"/>

      <CheckBox Grid.Row="3" Grid.Column="1"
                Content="{DynamicResource Text.UpdateSubmodules.UpdateToRemoteTrackingBranch}"
                IsChecked="{Binding EnableRemote, Mode=TwoWay}"
                ToolTip.Tip="--remote"/>

      <CheckBox Grid.Row="4" Grid.Column="1"
                Content="{DynamicResource Text.UpdateSubmodules.Recursive}"
                IsChecked="{Binding EnableRecursive, Mode=TwoWay}"
                ToolTip.Tip="--recursive"/>
    </Grid>

    <!-- A22: exact update targets and what each option changes. Presentation only: the executed
         command and its flags are unchanged, and the statuses shown are the ones already loaded
         in Repository.Submodules. -->
    <Border Margin="0,10,0,0" Padding="8,6" CornerRadius="4"
            BorderThickness="1" BorderBrush="{DynamicResource Brush.Border2}"
            Background="Transparent"
            IsVisible="{Binding IsClassicLayoutActive, Source={x:Static vm:Preferences.Instance}}">
      <StackPanel Orientation="Vertical" Spacing="2">
        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" FontSize="12" Foreground="{DynamicResource Brush.FG2}"
                     HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                     Text="{DynamicResource Text.Classic.Submodule.Targets}"/>
          <Panel Grid.Row="0" Grid.Column="1">
            <TextBlock FontSize="12" TextWrapping="Wrap" Classes="bold"
                       VerticalAlignment="Center"
                       IsVisible="{Binding HasTargets, Mode=OneWay}"
                       Text="{Binding TargetPaths, Mode=OneWay}"/>
            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="DarkOrange"
                       VerticalAlignment="Center"
                       IsVisible="{Binding HasTargets, Mode=OneWay, Converter={x:Static BoolConverters.Not}}"
                       Text="{DynamicResource Text.Classic.Submodule.NoTarget}"/>
          </Panel>
        </Grid>

        <StackPanel Orientation="Vertical" Spacing="2" Margin="0,4,0,0"
                    IsVisible="{Binding HasDirtyTargets, Mode=OneWay}">
          <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="DarkOrange"
                     Text="{DynamicResource Text.Classic.Submodule.WarnDirty}"/>

          <Grid ColumnDefinitions="120,*" RowDefinitions="Auto"
                IsVisible="{Binding HasModifiedTargets, Mode=OneWay}">
            <TextBlock Grid.Row="0" Grid.Column="0" FontSize="11" Foreground="{DynamicResource Brush.FG2}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                       Text="{DynamicResource Text.Classic.Submodule.WarnModified}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" FontSize="11" TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Text="{Binding ModifiedTargetPaths, Mode=OneWay}"/>
          </Grid>

          <Grid ColumnDefinitions="120,*" RowDefinitions="Auto"
                IsVisible="{Binding HasUnmergedTargets, Mode=OneWay}">
            <TextBlock Grid.Row="0" Grid.Column="0" FontSize="11" Foreground="{DynamicResource Brush.FG2}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                       Text="{DynamicResource Text.Classic.Submodule.WarnUnmerged}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" FontSize="11" TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Text="{Binding UnmergedTargetPaths, Mode=OneWay}"/>
          </Grid>
        </StackPanel>

        <!-- Local-path URLs are fetched through git's `file` transport, which is blocked for submodule
             clones by default. Warn before the run so the failure text is not a mystery. Nothing here
             changes the executed command or grants any transport allowance. -->
        <StackPanel Orientation="Vertical" Spacing="2" Margin="0,4,0,0"
                    IsVisible="{Binding HasLocalURLTargets, Mode=OneWay}">
          <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="DarkOrange"
                     Text="{DynamicResource Text.Classic.Submodule.WarnLocalURL}"/>

          <Grid ColumnDefinitions="120,*" RowDefinitions="Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" FontSize="11" Foreground="{DynamicResource Brush.FG2}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                       Text="{DynamicResource Text.Classic.Submodule.WarnLocalURLPaths}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" FontSize="11" TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Text="{Binding LocalURLTargetPaths, Mode=OneWay}"/>
          </Grid>
        </StackPanel>

        <StackPanel Orientation="Vertical" Spacing="2" Margin="0,4,0,0">
          <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG2}"
                     IsVisible="{Binding EnableRemote, Mode=OneWay, Converter={x:Static BoolConverters.Not}}"
                     Text="{DynamicResource Text.Classic.Submodule.ModeRecorded}"/>

          <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG2}"
                     IsVisible="{Binding EnableRemote, Mode=OneWay}"
                     Text="{DynamicResource Text.Classic.Submodule.ModeRemote}"/>

          <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG2}"
                     Text="{DynamicResource Text.Classic.Submodule.InitOn}">
            <TextBlock.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="IsEnableInitVisible" Mode="OneWay"/>
                <Binding Path="EnableInit" Mode="OneWay"/>
              </MultiBinding>
            </TextBlock.IsVisible>
          </TextBlock>

          <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG2}"
                     Text="{DynamicResource Text.Classic.Submodule.InitOff}">
            <TextBlock.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="IsEnableInitVisible" Mode="OneWay"/>
                <Binding Path="EnableInit" Mode="OneWay" Converter="{x:Static BoolConverters.Not}"/>
              </MultiBinding>
            </TextBlock.IsVisible>
          </TextBlock>

          <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG2}"
                     IsVisible="{Binding EnableRecursive, Mode=OneWay}"
                     Text="{DynamicResource Text.Classic.Submodule.RecursiveOn}"/>

          <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG2}"
                     IsVisible="{Binding EnableRecursive, Mode=OneWay, Converter={x:Static BoolConverters.Not}}"
                     Text="{DynamicResource Text.Classic.Submodule.RecursiveOff}"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
